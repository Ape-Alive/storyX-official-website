# 复制为 .env.development / .env.production，或直接使用仓库内对应文件
# Vite 会按 mode 自动加载：
#   npm run dev        → .env.development
#   npm run build      → .env.production

# 后台 API 根路径（需含 /api 前缀）
VITE_API_BASE_URL=http://localhost:5800/api

# 首页故事视频：CDN 完整 URL（见 src/config/cdn.js）
VITE_HOME_STORY_WEBM=https://cdn.huihuoai.com/videos/preview/98d72b4844184ef09ac829fd2fc8c29f.webm
VITE_HOME_STORY_MP4=https://cdn.huihuoai.com/videos/preview/b1bbff9776834f0fbdf1c453e513579c.mp4
