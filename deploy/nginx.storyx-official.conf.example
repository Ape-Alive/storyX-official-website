# 宝塔路径示例：
#   /www/server/panel/vhost/nginx/www.huihuoai.com.conf
#
# 没有源站证书时：只保留 listen 80。
# 宝塔申请 Let’s Encrypt 成功后，再由面板自动加 443 + ssl_certificate。

server {
    listen 80;
    server_name www.huihuoai.com huihuoai.com;

    root /opt/storyx-official-website/dist;
    index index.html;
    client_max_body_size 20m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    access_log /www/wwwlogs/www.huihuoai.com.log;
    error_log  /www/wwwlogs/www.huihuoai.com.error.log;

    # 有证书后再加（路径以宝塔实际为准）：
    # listen 443 ssl http2;
    # ssl_certificate     /www/server/panel/vhost/cert/www.huihuoai.com/fullchain.pem;
    # ssl_certificate_key /www/server/panel/vhost/cert/www.huihuoai.com/privkey.pem;
}
